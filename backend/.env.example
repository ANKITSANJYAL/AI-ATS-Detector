# Application Settings
APP_NAME="DocGuard & CareerMatch"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database
POSTGRES_DSN=postgresql://docguard:docguard_secret@localhost:5432/docguard
REDIS_DSN=redis://localhost:6379/0
REDIS_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM APIs
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=CHANGE_ME

# MCP Server
MCP_SERVER_URL=http://localhost:3001

# Clerk Authentication
CLERK_SECRET_KEY=CHANGE_ME
CLERK_PUBLISHABLE_KEY=CHANGE_ME

# Stripe Billing
STRIPE_API_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_PRICE_ID_AI_DETECTION=CHANGE_ME
STRIPE_PRICE_ID_ATS_SCORING=CHANGE_ME

# Observability
SENTRY_DSN=

# Document Processing
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
